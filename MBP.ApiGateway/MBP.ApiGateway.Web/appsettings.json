{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Cấu hình YARP
  "ReverseProxy": {
    "Routes": {
      // 1. Route cho Auth Service
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/auth" }
        ]
      },
      // 2. Route cho Booking Service
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/booking" }
        ]
      },
      // 3. Route cho Meeting Service
      "meeting-route": {
        "ClusterId": "meeting-cluster",
        "Match": {
          "Path": "/api/meeting/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/meeting" }
        ]
      },
      // 4. Route cho AI Service
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ai" }
        ]
      }
    },
    "Clusters": {
      // Định nghĩa địa chỉ thật của các service
      // Lưu ý: Nếu chạy localhost dev, hãy điền đúng port của từng service
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5001"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5002"
          }
        }
      },
      "meeting-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5003"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5004"
          }
        }
      }
    }
  }
}