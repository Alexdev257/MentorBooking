{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "RouteId": "auth-route",
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "admin-route": {
        "RouteId": "admin-route",
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/admin/{**catch-all}" }
        ]
      },

      "review-route": {
        "RouteId": "review-route",
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/reviews/{**catch-all}" }
        ]
      },

      "booking-route": {
        "RouteId": "booking-route",
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/booking/{**catch-all}" }
        ]
      },

      "slot-route": {
        "RouteId": "slot-route",
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/booking/mentors/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/booking/mentors/{**catch-all}" }
        ]
      },


      "auth-swagger-route": {
        "RouteId": "auth-swagger-route",
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth-service"
          }
        ]
      },
      "ai-swagger-route": {
        "RouteId": "ai-swagger-route",
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/ai-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/ai-service"
          }
        ]
      },
      "booking-swagger-route": {
        "RouteId": "booking-swagger-route",
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/booking-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/booking-service"
          }
        ]
      },
      "meeting-swagger-route": {
        "RouteId": "meeting-swagger-route",
        "ClusterId": "meeting-cluster",
        "Match": {
          "Path": "/meeting-service/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/meeting-service"
          }
        ]
      }


    },
    "Clusters": {
      "auth-cluster": {
        "ClusterId": "auth-cluster",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:4002"
          }
        }
      },
      "ai-cluster": {
        "ClusterId": "ai-cluster",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:4100"
          }
        }
      },
      "booking-cluster": {
        "ClusterId": "booking-cluster",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:4200"
          }
        }
      },
      "meeting-cluster": {
        "ClusterId": "meeting-cluster",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:4300"
          }
        }
      }
    }
  }
}


