          "name": "Get user by id",
          "request": {
            "auth": { "type": "noauth" }, "method": "GET", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/users/{{user_id}}", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","users","{{user_id}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Mentors (public)",
      "item": [
        {
          "name": "List mentors",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
            "var json = pm.response.json();",
            "var items = (json.data && json.data.items) || json.data || json.items || [];",
            "if (Array.isArray(items) && items.length > 0 && !pm.collectionVariables.get('mentor_id')) { pm.collectionVariables.set('mentor_id', items[0].id); console.log('mentor_id (from mentors):', items[0].id); }"
          ]}}],
          "request": {
            "auth": { "type": "noauth" }, "method": "GET", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/mentors?pageNumber=1&pageSize=10", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","mentors"], "query": [{"key":"pageNumber","value":"1"},{"key":"pageSize","value":"10"}] }
          }
        },
        {
          "name": "Get mentor by id",
          "request": {
            "auth": { "type": "noauth" }, "method": "GET", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/mentors/{{mentor_id}}", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","mentors","{{mentor_id}}"] }
          }
        }
      ]
    },
    {
      "name": "5. Reviews",
      "item": [
        {
          "name": "List reviews",
          "request": {
            "auth": { "type": "noauth" }, "method": "GET", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/reviews?pageNumber=1&pageSize=10&mentorId={{mentor_id}}", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","reviews"], "query": [{"key":"pageNumber","value":"1"},{"key":"pageSize","value":"10"},{"key":"mentorId","value":"{{mentor_id}}"}] }
          }
        },
        {
          "name": "Get review by mentor (student)",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/reviews/{{mentor_id}}", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","reviews","{{mentor_id}}"] },
            "description": "Bearer — role Student."
          }
        },
        {
          "name": "Create review",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.request.headers.upsert({key:'Authorization',value:'Bearer '+pm.collectionVariables.get('student_token')});"] }},
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 2xx', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
              "var json = pm.response.json(); var r = json.data || json;",
              "if (r && r.id) { pm.collectionVariables.set('review_id', r.id); console.log('review_id:', r.id); }"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"bookingId\": \"{{booking_id}}\",\n    \"mentorId\": \"{{mentor_id}}\",\n    \"rating\": 5,\n    \"comment\": \"Test review\"\n}" },
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/reviews", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","reviews"] },
            "description": "Dùng student_token tự động."
          }
        },
