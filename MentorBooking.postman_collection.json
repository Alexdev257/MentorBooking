          "request": {
            "method": "DELETE", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/booking/mentors/{{mentor_id}}/slots/{{slot_id}}", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","booking","mentors","{{mentor_id}}","slots","{{slot_id}}"] }
