      "item": [
        {
          "name": "List slots",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/booking/mentors/{{mentor_id}}/slots?includeBooked=false", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","booking","mentors","{{mentor_id}}","slots"], "query": [{"key":"includeBooked","value":"false"}] }
