          }
        },
        {
          "name": "Reject booking (mentor)",
          "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.request.headers.upsert({key:'Authorization',value:'Bearer '+pm.collectionVariables.get('mentor_token')});"] }}],
