            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/booking/mentees/{{student_id}}/bookings?pageNumber=1&pageSize=10", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","booking","mentees","{{student_id}}","bookings"], "query": [{"key":"pageNumber","value":"1"},{"key":"pageSize","value":"10"}] }
