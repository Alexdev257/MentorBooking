          "request": {
            "method": "PATCH", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/booking/bookings/{{booking_id}}/accept", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","booking","bookings","{{booking_id}}","accept"] },
