            "var json = pm.response.json();",
            "var items = (json.data && json.data.items) || json.data || json.items || [];",
            "if (Array.isArray(items) && items.length > 0) { pm.collectionVariables.set('mentor_id', items[0].id); console.log('mentor_id:', items[0].id); }"
          ]}}],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/admin/teachers?pageNumber=1&pageSize=10", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","admin","teachers"], "query": [{"key":"pageNumber","value":"1"},{"key":"pageSize","value":"10"}] }
          }
        },
        {
          "name": "Get teacher by id",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "https://api-gateway-lfnu.onrender.com/api/admin/teachers/{{mentor_id}}", "host": ["https://api-gateway-lfnu.onrender.com"], "path": ["api","admin","teachers","{{mentor_id}}"] }
          }
