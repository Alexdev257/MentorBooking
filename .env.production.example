# ============================================================
# MentorBooking - Production Environment Variables
# Copy this file to .env.production and fill in the values
# ============================================================

# ---------- DATABASE ----------
DB_USER=mentorbooking
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE

# ---------- JWT ----------
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_MIN_32_CHARS

# ---------- GATEWAY URL ----------
# Your Droplet IP or domain (used for JWT Issuer/Audience)
GATEWAY_URL=http://YOUR_DROPLET_IP

# ---------- ADMIN ----------
ADMIN_EMAIL=admin@mentorbooking.com
ADMIN_PASSWORD=Admin@123

# ---------- FIREBASE ----------
# Paste the entire Firebase credential JSON as one line
FIREBASE_CREDENTIAL_JSON=

# ---------- GEMINI AI ----------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ---------- ZOOM ----------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---------- EMAIL (Gmail SMTP) ----------
EMAIL_FROM=your-email@gmail.com
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
